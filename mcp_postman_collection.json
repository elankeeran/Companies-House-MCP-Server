{
    "info": {
        "_postman_id": "b6a8c2a1-7b9d-4e1f-8c3a-1b2c3d4e5f6a",
        "name": "Companies House MCP - Complete KYB Toolkit",
        "description": "Complete Know Your Business (KYB) collection for the Companies House MCP Server via HTTP transport.\n\nProvides tools for company search, profile retrieval, officers, beneficial owners (PSC), charges, insolvency, documents, and comprehensive due diligence reports.\n\nNOTE: You must provide your own Companies House API Key in the `apiKey` variable.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. List Tools",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/list\",\n  \"params\": {}\n}"
                },
                "url": {
                    "raw": "{{mcpBaseUrl}}/mcp",
                    "host": ["{{mcpBaseUrl}}"],
                    "path": ["mcp"]
                }
            }
        },
